{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Angie Dashboard document V4",
  "$comment": "V4 includes a portable board image and optional map markers and GPX references; dates and operational relationships retain their original meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "document",
    "board",
    "elements",
    "notebook",
    "timeline",
    "moduleLayouts"
  ],
  "properties": {
    "format": {
      "const": "angie-dashboard"
    },
    "formatVersion": {
      "type": "integer",
      "const": 4
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/utcDate"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDate"
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backgroundColor",
        "strokes",
        "quickNotes"
      ],
      "properties": {
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "strokes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stroke"
          }
        },
        "quickNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quickNote"
          }
        },
        "backgroundImage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataUrl",
            "layout"
          ],
          "properties": {
            "dataUrl": {
              "type": "string",
              "maxLength": 69905100,
              "pattern": "^data:image/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$"
            },
            "layout": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "notebook": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notebookBlock"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineEntry"
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markers", "gpx"],
      "properties": {
        "markers": { "type": "array", "items": { "$ref": "#/$defs/mapMarker" } },
        "gpx": { "type": "array", "items": { "$ref": "#/$defs/mapGpxReference" } }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pins", "strokes"],
      "properties": {
        "pins": { "type": "array", "items": { "$ref": "#/$defs/planPin" } },
        "strokes": { "type": "array", "items": { "$ref": "#/$defs/planStroke" } }
      }
    },
    "moduleLayouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": { "$ref": "#/$defs/layout" },
        "forecast": { "$ref": "#/$defs/layout" },
        "openMeteo": { "$ref": "#/$defs/layout" },
        "map": {
          "$ref": "#/$defs/layout"
        },
        "board": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "elements": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "information": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "operations": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "coordinates": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "clock": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "calculator": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "notebook": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "timeline": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "dotations": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "geographicPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -85.05112878, "maximum": 85.05112878 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "planPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementId", "latitude", "longitude", "visible"],
      "properties": {
        "elementId": { "$ref": "#/$defs/uuid" },
        "latitude": { "type": "number", "minimum": -85.05112878, "maximum": 85.05112878 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "visible": { "type": "boolean" }
      }
    },
    "planStroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "color", "width", "points"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "color": { "$ref": "#/$defs/color" },
        "width": { "type": "number", "minimum": 1, "maximum": 40 },
        "points": { "type": "array", "minItems": 2, "maxItems": 50000, "items": { "$ref": "#/$defs/geographicPosition" } }
      }
    },
    "mapMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "latitude", "longitude", "color"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "maxLength": 200 },
        "latitude": { "type": "number", "minimum": -85.05112878, "maximum": 85.05112878 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "mapGpxReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "size", "lastModified", "fingerprint", "visible", "color", "kilometers", "kilometerInterval"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "lastModified": { "type": "integer", "minimum": 0 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "visible": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "kilometers": { "type": "boolean" },
        "kilometerInterval": { "type": "number", "enum": [0.1, 0.5, 1, 5, 10] }
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "utcDate": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "tag": {
      "type": "string",
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "Disponible",
        "Activada",
        "Aproximandose",
        "Interviniendo",
        "Trasladando",
        "Transfiriendo",
        "Operativa",
        "Inoperativa",
        "Personalizada"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "color",
        "width",
        "points"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "tool": {
          "enum": [
            "pen",
            "eraser"
          ]
        },
        "color": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      },
      "if": {
        "properties": {
          "tool": {
            "const": "pen"
          }
        }
      },
      "then": {
        "properties": {
          "color": {
            "$ref": "#/$defs/color"
          }
        }
      },
      "else": {
        "properties": {
          "color": {
            "type": "null"
          }
        }
      }
    },
    "quickNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "position",
        "width",
        "height",
        "title",
        "scale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "title": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "visual": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "assetId",
            "scale"
          ],
          "properties": {
            "type": {
              "const": "asset"
            },
            "assetId": {
              "enum": [
                "ambulance",
                "pathfinder",
                "quad",
                "checkpoint",
                "hydration",
                "start",
                "finish",
                "warning",
                "pushpin"
              ]
            },
            "rotation": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "scale"
          ],
          "properties": {
            "type": {
              "const": "emoji"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "rotation": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            }
          }
        }
      ]
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes",
        "tags",
        "currentEntryId"
      ],
      "properties": {
        "status": {
          "oneOf": [
            {
              "$ref": "#/$defs/status"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "currentEntryId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "notesColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "visual",
        "information",
        "position",
        "isUnit",
        "operational",
        "pinVisible"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "information": {
          "type": "string"
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "isUnit": {
          "type": "boolean"
        },
        "operational": {
          "oneOf": [
            {
              "$ref": "#/$defs/operational"
            },
            {
              "type": "null"
            }
          ]
        },
        "nameOffset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "nameColor": {
          "enum": [
            "dark",
            "light",
            "yellow",
            "blue",
            "green",
            "red"
          ]
        },
        "pinAnchor": {
          "oneOf": [
            { "enum": ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          ]
        },
        "nameHidden": {
          "type": "boolean"
        },
        "nameFontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 72
        },
        "pinVisible": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "isUnit": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "operational": {
            "$ref": "#/$defs/operational"
          }
        }
      },
      "else": {
        "properties": {
          "operational": {
            "type": "null"
          }
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "checked"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "text": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        }
      }
    },
    "notebookBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "note"
            },
            "text": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "items",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "checklist"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/checklistItem"
              }
            },
            "title": {
              "type": "string"
            }
          }
        }
      ]
    },
    "timelineEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurredAt",
            "text",
            "revisions"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "manual"
            },
            "occurredAt": {
              "$ref": "#/$defs/utcDate"
            },
            "text": {
              "type": "string"
            },
            "revisions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurredAt",
            "unitId",
            "unitName",
            "previousStatus",
            "nextStatus",
            "revisions"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "status-change"
            },
            "occurredAt": {
              "$ref": "#/$defs/utcDate"
            },
            "unitId": {
              "$ref": "#/$defs/uuid"
            },
            "unitName": {
              "type": "string"
            },
            "previousStatus": {
              "oneOf": [
                {
                  "$ref": "#/$defs/status"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextStatus": {
              "$ref": "#/$defs/status"
            },
            "customLabel": {
              "type": "string",
              "minLength": 1
            },
            "customColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "revisions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/revision"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "nextStatus": {
                    "const": "Personalizada"
                  }
                },
                "required": [
                  "nextStatus"
                ]
              },
              "then": {
                "properties": {
                  "customLabel": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "customLabel"
                ]
              }
            }
          ]
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "referenceSize"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "referenceSize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "revision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "recordedAt",
            "text"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "text"
            },
            "recordedAt": {
              "$ref": "#/$defs/utcDate"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "recordedAt"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "delete"
            },
            "recordedAt": {
              "$ref": "#/$defs/utcDate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "recordedAt"
          ],
          "properties": {
            "id": {
