{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Angie Dashboard document V3",
  "$comment": "V3 coherence, UUID uniqueness, chronology and finite layout references are checked by validateDocument; historical validators remain independent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "document",
    "board",
    "elements",
    "notebook",
    "timeline",
    "moduleLayouts"
  ],
  "properties": {
    "format": {
      "const": "angie-dashboard"
    },
    "formatVersion": {
      "type": "integer",
      "const": 3
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/utcDate"
        },
        "updatedAt": {
          "$ref": "#/$defs/utcDate"
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backgroundColor",
        "strokes",
        "quickNotes"
      ],
      "properties": {
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "strokes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stroke"
          }
        },
        "quickNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quickNote"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "notebook": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notebookBlock"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineEntry"
      }
    },
    "moduleLayouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "board": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "elements": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "information": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "operations": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "coordinates": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "clock": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "calculator": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "notebook": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "timeline": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "dotations": {
          "$ref": "#/$defs/layout",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "utcDate": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "tag": {
      "type": "string",
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "Disponible",
        "Activada",
        "Aproximandose",
        "Interviniendo",
        "Trasladando",
        "Transfiriendo",
        "Operativa",
        "Inoperativa"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "color",
        "width",
        "points"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "tool": {
          "enum": [
            "pen",
            "eraser"
          ]
        },
        "color": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      },
      "if": {
        "properties": {
          "tool": {
            "const": "pen"
          }
        }
      },
      "then": {
        "properties": {
          "color": {
            "$ref": "#/$defs/color"
          }
        }
      },
      "else": {
        "properties": {
          "color": {
            "type": "null"
          }
        }
      }
    },
    "quickNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "position",
        "width",
        "height",
        "title",
        "scale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "title": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "visual": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "assetId",
            "scale"
          ],
          "properties": {
            "type": {
              "const": "asset"
            },
            "assetId": {
              "enum": [
                "ambulance",
                "pathfinder",
                "quad",
                "checkpoint",
                "hydration",
                "start",
                "finish",
                "warning",
                "pushpin"
              ]
            },
            "scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "scale"
          ],
          "properties": {
            "type": {
              "const": "emoji"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            }
          }
        }
      ]
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes",
        "tags",
        "currentEntryId"
      ],
      "properties": {
        "status": {
          "oneOf": [
            {
              "$ref": "#/$defs/status"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "currentEntryId": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "visual",
        "information",
        "position",
        "isUnit",
        "operational",
        "pinVisible"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "$ref": "#/$defs/nonBlank"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "information": {
          "type": "string"
        },
        "position": {
          "oneOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "isUnit": {
          "type": "boolean"
        },
        "operational": {
          "oneOf": [
            {
              "$ref": "#/$defs/operational"
            },
            {
              "type": "null"
            }
          ]
        },
        "nameFontSize": { "type": "number", "minimum": 8, "maximum": 72 },
        "pinVisible": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "isUnit": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "operational": {
            "$ref": "#/$defs/operational"
          }
        }
      },
      "else": {
        "properties": {
          "operational": {
            "type": "null"
          }
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "checked"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "text": {
          "type": "string"
        },
        "checked": {
          "type": "boolean"
        }
      }
    },
    "notebookBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "note"
            },
            "text": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "items",
            "title"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "checklist"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/checklistItem"
              }
            },
            "title": {
              "type": "string"
            }
          }
        }
      ]
    },
    "timelineEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurredAt",
            "text",
            "revisions"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "manual"
            },
            "occurredAt": {
              "$ref": "#/$defs/utcDate"
            },
            "text": {
              "type": "string"
            },
            "revisions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "occurredAt",
            "unitId",
            "unitName",
            "previousStatus",
            "nextStatus",
            "revisions"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "type": {
              "const": "status-change"
            },
            "occurredAt": {
              "$ref": "#/$defs/utcDate"
            },
            "unitId": {
              "$ref": "#/$defs/uuid"
            },
            "unitName": {
              "type": "string"
            },
            "previousStatus": {
              "oneOf": [
                {
                  "$ref": "#/$defs/status"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nextStatus": {
              "$ref": "#/$defs/status"
            },
            "revisions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/revision"
              }
            }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "referenceSize"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "referenceSize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "revision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "recordedAt",
            "text"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "text"
            },
            "recordedAt": {
              "$ref": "#/$defs/utcDate"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "recordedAt"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "delete"
            },
            "recordedAt": {
              "$ref": "#/$defs/utcDate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "recordedAt"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "kind": {
              "const": "correction"
            },
            "recordedAt": {
              "$ref": "#/$defs/utcDate"
            }
          }
        }
      ]
    }
  }
}
